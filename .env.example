# Ключ API Яндекс Карт НЕ обязателен: по умолчанию карта работает
# на бесплатном открытом доступе JavaScript API 2.1 (лимит ~50 000 запросов в сутки на IP).
# Если хотите использовать собственный ключ (например, с тарифа
# «Карточки и статическая карта», бесплатный уровень) — раскомментируйте и укажите его:
# VITE_YANDEX_MAPS_API_KEY=ваш_ключ

# release | development | production
VITE_YANDEX_MAPS_MODE=release
